# config.example.yaml 의 os.environ/ 참조와 1:1. 실제 값은 .env(git 제외)에 둔다.
LITELLM_MASTER_KEY=sk-changeme
DATABASE_URL=postgresql://litellm:changeme@localhost:5432/litellm

AZURE_API_BASE_KR=https://your-kr.openai.azure.com
AZURE_API_KEY_KR=changeme
AZURE_API_BASE_JP=https://your-jp.openai.azure.com
AZURE_API_KEY_JP=changeme

GCP_PROJECT=your-gcp-project

VLLM_BASE_URL=http://vllm:8000/v1

# Bedrock 은 표준 AWS 자격증명 체인을 쓴다(AWS_ACCESS_KEY_ID 등).
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
AWS_REGION_NAME=us-east-1

# 관측(선택)
# LANGFUSE_PUBLIC_KEY=changeme
# LANGFUSE_SECRET_KEY=changeme
