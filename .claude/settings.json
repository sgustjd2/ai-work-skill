{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "uv run --no-sync python -X utf8 templates/doc_lint.py --pre", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "uv run --no-sync python -X utf8 templates/py_format.py --post", "timeout": 40 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "uv run --no-sync python -X utf8 templates/doc_lint.py --stop", "timeout": 20 }
        ]
      }
    ]
  }
}
